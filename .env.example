# Copy to .env for local experiments only. Do not commit real secrets.

HOST=127.0.0.1
PORT=8787

# Optional: override generated Latch keys.
# OPERATOR_TOKEN=op_replace_me
# AGENT_TOKEN=agent_replace_me

# Optional: PRIMARY OpenAI-compatible provider. Set these and they win over
# data/llm-provider.json. Point baseUrl at a local Ollama for a local-first setup.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=replace-with-model-name
# LLM_API_KEY=replace-with-provider-key
# LLM_TIMEOUT_MS=60000

# Optional: FALLBACK provider — your OWN external model, called only when the primary
# fails and the routing preference is not "Local only". The key stays on this host; the
# worker never receives it. These win over the "fallback" block in data/llm-provider.json.
# BASE_URL, MODEL and API_KEY must ALL be set before the fallback counts as configured.
# LLM_FALLBACK_PROVIDER=openai-compatible
# LLM_FALLBACK_BASE_URL=https://api.mistral.ai/v1
# LLM_FALLBACK_MODEL=replace-with-model-name
# LLM_FALLBACK_API_KEY=replace-with-provider-key
# LLM_FALLBACK_TIMEOUT_MS=60000

# Optional: server-side phone push.
# NOTIFY_ENABLED=false
# NOTIFY_PROVIDER=ntfy
# NOTIFY_URL=https://ntfy.sh/replace-with-private-random-topic
# NOTIFY_TOKEN=replace-with-provider-token-if-needed
# NOTIFY_TIMEOUT_MS=5000

# Optional: trusted-host GitHub repo creation connector.
# Prefer Configure-GitHub.ps1 so the token stays in data\github.json.
# GITHUB_TOKEN=replace-with-fine-grained-token
# GITHUB_OWNER=replace-with-org-name-if-owner-type-is-org
# GITHUB_DEFAULT_REPO=CompassProjects
# GITHUB_OWNER_TYPE=user
# GITHUB_DEFAULT_VISIBILITY=private
# GITHUB_AUTO_INIT=true
